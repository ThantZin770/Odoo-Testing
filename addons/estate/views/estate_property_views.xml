<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Property List View -->
    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="property_type_id" string="Property Type"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="state"
                       string="Status"
                       widget="badge"
                       decoration-muted="state == 'new'"
                       decoration-info="state == 'offer_received'"
                       decoration-success="state == 'offer_accepted'"
                       decoration-primary="state == 'sold'"
                       decoration-danger="state == 'canceled'"/>

            </list>
        </field>
    </record>

    <!-- Property Form View -->
    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button
                        name="action_sold"
                        type="object"
                        string="Sold"
                        class="btn-primary"
                        invisible="state in ['sold', 'canceled']"
                    />
                    <button
                        name="action_cancel"
                        type="object"
                        string="Cancel"
                        invisible="state in ['sold', 'canceled']"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="new,offer_received,offer_accepted,sold,canceled"
                    />
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Property Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Family House"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Basic Information">
                            <field name="property_type_id" string="Property Type"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>

                        <group string="Property Details">
                            <field name="bedrooms"/>
                            <field name="living_area" string="Living Area (sqm)"/>
                            <field name="garden"/>
                            <field
                                name="garden_area"
                                invisible="not garden"
                                required="garden"
                            />
                        </group>
                    </group>

                    <group string="Pricing">
                        <field name="expected_price"/>
                    </group>

                    <!-- Sales Information -->
                    <group string="Sales Information">
                        <field name="buyer_id"/>
                        <field name="salesperson_id"/>
                    </group>


                    <notebook>
                        <page string="Description" name="description">
                            <field
                                name="description"
                                placeholder="Enter property details..."
                            />
                        </page>

                        <page string="Offers" name="offers">

                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="status"
                                           widget="badge"
                                           readonly="1"
                                           decoration-success="status == 'accepted'"
                                           decoration-danger="status == 'refused'"
                                           decoration-warning="status == 'pending'"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>

                                    <button name="action_accept"
                                            type="object"
                                            string="Accept"
                                            class="btn-success"
                                            invisible="status != 'pending'"/>

                                    <button name="action_refuse"
                                            type="object"
                                            string="Refuse"
                                            class="btn-danger"
                                            invisible="status != 'pending'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>




    <!-- Property Search View -->
    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" string="Property Name"/>
                <field name="postcode"/>
                <field name="property_type_id"/>

                <separator/>

                <filter
                    name="filter_new"
                    string="New"
                    domain="[('state', '=', 'new')]"
                />
                <filter
                    name="filter_offer_received"
                    string="Offer Received"
                    domain="[('state', '=', 'offer_received')]"
                />
                <filter
                    name="filter_offer_accepted"
                    string="Offer Accepted"
                    domain="[('state', '=', 'offer_accepted')]"
                />
                <filter
                    name="filter_sold"
                    string="Sold"
                    domain="[('state', '=', 'sold')]"
                />
                <filter
                    name="filter_canceled"
                    string="Canceled"
                    domain="[('state', '=', 'canceled')]"
                />

                <group>
                    <filter
                        name="group_by_property_type"
                        string="Property Type"
                        context="{'group_by': 'property_type_id'}"
                    />
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Property Kanban View -->
    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="postcode"/>
                <field name="property_type_id"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="expected_price"/>
                <field name="state"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong class="fs-5">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="badge"
                                       decoration-muted="state == 'new'"
                                       decoration-info="state == 'offer_received'"
                                       decoration-success="state == 'offer_accepted'"
                                       decoration-primary="state == 'sold'"
                                       decoration-danger="state == 'canceled'"/>
                            </div>

                            <div class="text-muted mt-2">
                                <field name="property_type_id"/>
                                <span> · </span>
                                <field name="postcode"/>
                            </div>

                            <div class="mt-3">
                                <div>
                                    <i class="fa fa-bed me-2" title="Bedrooms"/>
                                    <field name="bedrooms"/> Bedrooms
                                </div>
                                <div>
                                    <i class="fa fa-arrows-alt me-2" title="Living Area"/>
                                    <field name="living_area"/> sqm
                                </div>
                            </div>

                            <div class="mt-3 pt-2 border-top">
                                <span class="text-muted">Expected Price</span>
                                <h4 class="mb-0">
                                    <field name="expected_price"/>
                                </h4>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>